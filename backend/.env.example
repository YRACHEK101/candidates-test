## Only needed if you run the backend WITHOUT Docker (npm run dev).
## With Docker, the values come from the .env file at the root of the project.

## Environment Variables
PORT=3001
JWT_KEY=change_me_to_a_long_random_string

## Development Database
DEV_DB_USERNAME=conduit
DEV_DB_PASSWORD=change_me
DEV_DB_NAME=conduit
DEV_DB_HOSTNAME=127.0.0.1
DEV_DB_DIALECT=postgres
